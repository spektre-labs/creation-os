# syntax=docker/dockerfile:1.6
# SPDX-License-Identifier: LicenseRef-SCSL-1.0 OR AGPL-3.0-only
#
# σ-serve image: FastAPI scoring surface only (no C kernel binaries).
# Build from repo root:
#   docker build -f Dockerfile.sigma-serve -t creation-os-sigma-api .
# Run:
#   docker run --rm -p 8000:8000 creation-os-sigma-api
#
FROM python:3.12-slim
WORKDIR /src

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE LICENSE-AGPL-3.0.txt LICENSE-SCSL-1.0.md /src/
COPY python /src/python

RUN pip install --no-cache-dir -e ".[serve]"

RUN useradd -m -u 10001 cos
USER cos

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "cos.api.serve:app", "--host", "0.0.0.0", "--port", "8000"]
