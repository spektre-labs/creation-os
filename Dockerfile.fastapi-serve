# Creation OS — FastAPI σ-gate ASGI image (``cos.serve`` on :8420).
# Multi-stage: install ``creation-os[serve]`` into a prefix, copy to slim runtime.
# Does not replace the C / ``cos-serve`` image (see Dockerfile / Dockerfile.prod).
#
# Build:
#   docker build -f Dockerfile.fastapi-serve -t creation-os-fastapi:0.1.0 .
# Run:
#   docker run --rm -p 8420:8420 creation-os-fastapi:0.1.0
#   curl -fsS http://127.0.0.1:8420/health

FROM python:3.12-slim AS builder

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN pip install --no-cache-dir --upgrade pip

COPY pyproject.toml README.md LICENSE LICENSE-AGPL-3.0.txt LICENSE-SCSL-1.0.md ./
COPY python ./python

RUN pip install --no-cache-dir --prefix=/install ".[serve]"

# ── Runtime: non-root, no build toolchain ────────────────────────────────
FROM python:3.12-slim AS runtime

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash --uid 10001 cos

COPY --from=builder /install/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /install/bin/ /usr/local/bin/

WORKDIR /home/cos
USER cos

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

LABEL org.opencontainers.image.title="Creation OS (FastAPI σ-serve)" \
    org.opencontainers.image.description="ASGI σ-gate API — FastAPI + uvicorn" \
    org.opencontainers.image.source="https://github.com/spektre-labs/creation-os" \
    org.opencontainers.image.licenses="LicenseRef-SCSL-1.0 OR AGPL-3.0-only" \
    org.opencontainers.image.vendor="Spektre Labs"

EXPOSE 8420

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8420/health', timeout=3)" || exit 1

CMD ["uvicorn", "cos.serve:create_app", "--factory", "--host", "0.0.0.0", "--port", "8420"]
